# Production profile for Vercel + GitHub Actions.
# 1) Copy to .env.prod and fill secrets (gitignored — never commit).
# 2) Paste the entire .env.prod into GitHub Actions secret ENV_PROD.
APP_ENV=production

# Supabase Free — Transaction pooler (required on Vercel; not SQLite)
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

BOT_TOKEN=
BACKEND_URL=https://course-hub-devdjangoreacts-projects.vercel.app

TELEGRAM_MODE=webhook
TELEGRAM_AUTO_SET_WEBHOOK=true
TELEGRAM_WEBHOOK_PATH=/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

PAYMENT_PROVIDER=simulated
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_CURRENCY=USD
LAVA_ENV=production
PAYMENT_LINK_MODE=direct

LOG_LEVEL=INFO
SUPPORTED_LANGUAGES=uk,en
DEFAULT_LANGUAGE=uk
SEARCH_SUGGESTION_MIN_CHARS=3
SEARCH_SUGGESTION_LIMIT=5
PARSER_REQUEST_TIMEOUT_SECONDS=10

# Optional SMTP for post-payment / promo email (empty host = disabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Catalog delivery channel (required on Vercel for invite/copy fallbacks)
CATALOG_CHANNEL_ID=
CATALOG_INVITE_LINK=
CATALOG_DISCUSSION_GROUP_ID=

# CI deploy credentials (read by Actions from ENV_PROD; not synced into app runtime)
# Token: https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_ORG_ID=team_JumlzVUZHmFg6TFNC8PzmHpJ
VERCEL_PROJECT_ID=prj_6RYWeAPZAiyx0NR958XPH2vjujJc
