# Development / testing profile (separate bot token from production)
APP_ENV=development
HOST=0.0.0.0
PORT=8000

DATABASE_URL=sqlite+aiosqlite:///./course_hub_dev.db

# Development/testing Telegram bot token
BOT_TOKEN=
BACKEND_URL=http://localhost:8000

# Local dev: polling (no public URL). For webhook + Cloudflare Tunnel use TELEGRAM_MODE=webhook
# and BACKEND_URL=https://<tunnel>
TELEGRAM_MODE=polling
TELEGRAM_AUTO_SET_WEBHOOK=true
TELEGRAM_WEBHOOK_PATH=/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=dev-admin
ADMIN_SESSION_SECRET=dev-session-secret

PAYMENT_PROVIDER=simulated
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=dev-webhook-secret
PAYMENT_CURRENCY=USD
PAYMENT_LINK_MODE=direct

LOG_LEVEL=DEBUG

SUPPORTED_LANGUAGES=ru,uk,en
DEFAULT_LANGUAGE=ru
SEARCH_SUGGESTION_MIN_CHARS=3
SEARCH_SUGGESTION_LIMIT=5

# Optional SMTP for post-payment / promo email (empty host = disabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Catalog delivery channel (also set on Vercel)
CATALOG_CHANNEL_ID=
CATALOG_INVITE_LINK=
CATALOG_DISCUSSION_GROUP_ID=
