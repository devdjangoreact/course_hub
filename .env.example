# Course Hub configuration (copy to .env and fill real values; never commit .env)

# Run profile: development | production
APP_ENV=development

# HTTP server
HOST=0.0.0.0
PORT=8000

# Database (SQLite phase 1; switch to PostgreSQL by changing this URL only)
# SQLite:     sqlite+aiosqlite:///./course_hub.db
# PostgreSQL: postgresql+asyncpg://user:password@host:5432/course_hub
DATABASE_URL=sqlite+aiosqlite:///./course_hub.db

# Telegram bot
BOT_TOKEN=
# Public base/callback URL the bot/payments use
BACKEND_URL=http://localhost:8000

# Telegram update transport: webhook (default, Vercel/serverless) | polling (local/VPS)
TELEGRAM_MODE=webhook
# On startup: webhook -> setWebhook(BACKEND_URL+path); polling -> deleteWebhook
TELEGRAM_AUTO_SET_WEBHOOK=true
TELEGRAM_WEBHOOK_PATH=/api/telegram/webhook
# Optional shared secret; Telegram sends X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# Database notes:
# Supabase Free (Vercel) Transaction pooler example:
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Direct (migrations if pooler blocks DDL):
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# First admin account (seeded on initial run; password is stored hashed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Session secret for the admin panel
ADMIN_SESSION_SECRET=change-me-too

# Payments
PAYMENT_PROVIDER=simulated
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_CURRENCY=USD
LAVA_ENV=production
# Payment link in bot: direct | checkout (default: direct)
PAYMENT_LINK_MODE=direct

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Multilingual catalog/search/parser
SUPPORTED_LANGUAGES=ru,uk,en
DEFAULT_LANGUAGE=ru
SEARCH_SUGGESTION_MIN_CHARS=3
SEARCH_SUGGESTION_LIMIT=5
PARSER_REQUEST_TIMEOUT_SECONDS=10

# Optional SMTP for post-payment / promo email (empty host = disabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Catalog delivery channel (local tools + Vercel bot fallbacks)
CATALOG_CHANNEL_ID=
CATALOG_INVITE_LINK=
CATALOG_DISCUSSION_GROUP_ID=

# Local catalog tools only (Flancki parse via Pyrogram user — not required on Vercel)
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION_NAME=catalog_user
TG_FLANCKI_CHAT_ID=-1001343804259
TG_PARSE_YEARS=2
TG_DOWNLOAD_MEDIA=true

# Local AI enrich (AI_PROVIDER=nvidia|openrouter|aws|perplexity)
AI_PROVIDER=nvidia
# Enrich uses an LLM with built-in web search (not DuckDuckGo)
ENRICH_AI_PROVIDER=perplexity
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai
PERPLEXITY_MODEL=sonar-pro
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.2
# Webshare: direct = IP:port per proxy; residential/mobile auto-switch to backbone+sticky (no -rotate)
WEBSHERE_PROXY_API_KEY=
WEBSHERE_PROXY_MODE=direct
# Optional: comma-separated plan ids; empty = all active plans
WEBSHERE_PROXY_PLAN_IDS=
RELAY_LOCAL_PORT=8899
BROWSER_HEADLESS=1
# SearXNG: one URL, or comma-separated instances (queried in parallel)
SEARXNG_URL=http://localhost:8080/search
# SEARXNG_URLS=http://127.0.0.1:8080/search,http://127.0.0.1:8081/search
# Client→SearXNG via session proxy (engines still need settings.yml outgoing)
SEARXNG_USE_SESSION_PROXY=0
# LLM (nvidia/openrouter): use session upstream proxy, or set LLM_HTTP_PROXY
LLM_USE_SESSION_PROXY=1
# LLM_HTTP_PROXY=http://user:pass@host:port
#
# SearXNG engine→web proxies (per instance settings.yml) — docs.searxng.org outgoing:
#   outgoing:
#     proxies:
#       all://:
#         - http://user:pass@proxy1:port
#         - http://user:pass@proxy2:port
#     extra_proxy_timeout: 10.0
# Multiple proxies = round-robin; engines already run in parallel threads.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
ENRICH_OPENROUTER_MODEL=perplexity/sonar-pro
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=
